'══════════════════════════════════════════════════════════════════════════
' ResumirMesas_LOC  ·  v4
'
' Resume el reporte de mesas del SIU y separa el tribunal en
' Presidente / Vocal 1 / Vocal 2 tomando los roles de la base de datos
' local (copia de la planilla de Drive "Mesas de Examen").
'
' CAMBIOS RESPECTO DE v3
'   1. El tribunal ahora es REQUISITO, no un bonus. Si la fila que gana por
'      código y nombre no comparte al menos 2 docentes con el reporte, se
'      descarta y se busca la fila por tribunal.
'   2. Se eliminó el volcado alfabético. Si no se puede determinar el rol,
'      D/E/F quedan VACÍAS y los docentes se informan en la columna ESTADO.
'      Antes ese volcado producía resultados creíbles pero al revés.
'   3. La normalización saca paréntesis y saltos de línea.
'   4. Sub DiagnosticarMesa() para ver por qué eligió una fila.
'
' IMPORTANTE: reemplazar TODO el módulo anterior, no pegar al lado.
'══════════════════════════════════════════════════════════════════════════


'───────────────────────────── CONFIGURACIÓN ─────────────────────────────
Const RUTA_BD        = "/home/cristian/Documentos/ALUMNOS/BASE DE DATOS/Base de datos de MESAS Y DOCENTES.ods"

Const BD_FILA_1      = 5      ' índice 0-based de la 1ra fila de datos (= fila 6)
Const BD_COL_COD     = 0      ' A  CÓDIGO
Const BD_COL_MAT     = 1      ' B  ASIGNATURA
Const BD_COL_PRES    = 4      ' E  PRESIDENTE
Const BD_COL_VOC1    = 5      ' F  VOCAL
Const BD_COL_VOC2    = 6      ' G  VOCAL

Const REP_FILA_1     = 4      ' índice 0-based donde arranca el escaneo del reporte

Const UMBRAL_DOC     = 0.55   ' similitud mínima para dar por igual a dos docentes
Const PUNTAJE_MIN    = 50     ' puntaje mínimo para aceptar una fila de la BD
Const USAR_NOMBRE_BD = False  ' False = escribe el nombre como viene del reporte


'──────────────────────── BD cargada en memoria ──────────────────────────
Dim gN As Long
Dim gCod() As String
Dim gCodNum() As String
Dim gMat() As String
Dim gMatO() As String
Dim gCodO() As String
Dim gDocO() As String
Dim gDocN() As String
Dim gEqN As Long
Dim gEqDe() As String
Dim gEqA() As String

' Salidas auxiliares de PuntajeFila
Dim gCoinc As Integer
Dim gSumSim As Double


'══════════════════════════════════════════════════════════════════════════
' PROCEDIMIENTO PRINCIPAL
'══════════════════════════════════════════════════════════════════════════
Sub ResumirMesasExamen()
    Dim oDoc As Object, oSheets As Object, oOrig As Object, oRes As Object
    Dim oBD As Object, oProgreso As Object
    Dim nUlt As Long, nFila As Long, nDest As Long, nDatos As Long
    Dim sA As String, sLinea As String
    Dim sCod As String, sMat As String, sTitulo As String
    Dim sFecha As String, sHora As String, sDocentes As String
    Dim aRepO As Variant, aRepN As Variant, aRepTok As Variant
    Dim vRes As Variant
    Dim vRep As Variant
    Dim aSalida()
    Dim aColor() As Long
    Dim j As Integer, k As Long
    Dim nOK As Long, nRev As Long, nSin As Long
    Dim bIncluir As Boolean
    Dim bBloqueado As Boolean

    On Error Goto ManejoError

    nFila      = 0
    nDest      = 1
    sTitulo    = "(ninguna todavia)"
    bBloqueado = False

    oDoc    = ThisComponent
    oSheets = oDoc.Sheets
    oOrig   = oSheets.getByIndex(0)

    oBD = AbrirBaseDatos(RUTA_BD)
    If IsNull(oBD) Then
        MsgBox "No se pudo abrir la base de datos. La macro se detiene.", 16, "Error"
        Exit Sub
    End If
    CargarBaseDatos(oBD)
    oBD.close(True)

    If gN = 0 Then
        MsgBox "La base de datos se abrio pero no se leyo ninguna mesa." & Chr(10) & _
               "Verifica que los datos empiecen en la fila " & (BD_FILA_1 + 1) & _
               " de la primera hoja.", 16, "Error"
        Exit Sub
    End If

    nUlt = UltimaFila(oOrig)

    ' Lectura en bloque del reporte: una sola llamada en vez de miles.
    ' Se usa solo para DETECTAR encabezados de materia y filas "Mesa:".
    ' Los valores (fecha, hora, docentes) se leen con getString mas abajo,
    ' porque getDataArray devuelve numeros para celdas con formato.
    vRep = oOrig.getCellRangeByPosition(0, 0, 5, nUlt).getDataArray()

    If oSheets.hasByName("RESUMIDO") Then oSheets.removeByName("RESUMIDO")
    oSheets.insertNewByName("RESUMIDO", oSheets.getCount())
    oRes = oSheets.getByName("RESUMIDO")

    oRes.getCellByPosition(0, 0).setString("Codigo")
    oRes.getCellByPosition(1, 0).setString("Materia")
    oRes.getCellByPosition(2, 0).setString("Fecha")
    oRes.getCellByPosition(3, 0).setString("Hora")
    oRes.getCellByPosition(4, 0).setString("Presidente")
    oRes.getCellByPosition(5, 0).setString("Vocal 1")
    oRes.getCellByPosition(6, 0).setString("Vocal 2")
    oRes.getCellByPosition(7, 0).setString("ESTADO")

    ReDim aSalida(nUlt)
    ReDim aColor(nUlt)

    nDest   = 1
    nOK     = 0
    nRev    = 0
    nSin    = 0
    sTitulo = ""
    sCod    = ""
    sMat    = ""

    oDoc.lockControllers()
    bBloqueado = True

    oProgreso = oDoc.getCurrentController().getFrame().createStatusIndicator()
    oProgreso.start("Resumiendo mesas...", nUlt)

    nFila = REP_FILA_1
    While nFila <= nUlt

        If (nFila Mod 50) = 0 Then oProgreso.setValue(nFila)

        sA = TextoDe(vRep(nFila)(0))

        If Len(sA) > 0 And Left(sA, 1) = "(" Then
            sTitulo = sA
            sCod    = ExtraerCodigoMateria(sA)
            sMat    = ExtraerNombreMateria(sA)
        End If

        sLinea = sA
        If Len(sLinea) = 0 Then sLinea = TextoFila(vRep(nFila), 1, 5)

        If InStr(sLinea, "Mesa:") > 0 And Len(sTitulo) > 0 Then

            bIncluir = True
            If InStr(1, sLinea, "Libre", 1) > 0     Then bIncluir = False
            If InStr(1, sLinea, "El Maiten", 1) > 0 Then bIncluir = False
            If InStr(1, sLinea, "El Mait" & Chr(233) & "n", 1) > 0 Then bIncluir = False

            If bIncluir Then
                nDatos = nFila + 2
                Do While nDatos <= nUlt
                    If Len(TextoDe(vRep(nDatos)(1))) = 0 Then Exit Do
                    If Left(TextoDe(vRep(nDatos)(0)), 1) = "(" Then Exit Do

                    sFecha    = Trim(oOrig.getCellByPosition(1, nDatos).getString())
                    sHora     = Trim(oOrig.getCellByPosition(2, nDatos).getString())
                    sDocentes = Trim(oOrig.getCellByPosition(3, nDatos).getString())

                    aRepO = SepararDocentes(sDocentes)

                    If UBound(aRepO) < 0 Then
                        aSalida(nDest - 1) = Array(sCod, sMat, sFecha, sHora, "", "", "", _
                            "SIN RESOLVER: la mesa no tiene docentes cargados en el reporte")
                        aColor(nDest - 1) = RGB(255, 199, 206)
                        nSin = nSin + 1
                    Else
                        aRepN   = NormalizarLista(aRepO)
                        aRepTok = TokenizarLista(aRepN)

                        vRes = ResolverMesa(sCod, sMat, aRepO, aRepN, aRepTok)

                        aSalida(nDest - 1) = Array(sCod, sMat, sFecha, sHora, _
                                                   vRes(0), vRes(1), vRes(2), vRes(3))

                        If vRes(3) = "OK" Then
                            nOK = nOK + 1
                            aColor(nDest - 1) = -1
                        ElseIf Left(vRes(3), 12) = "SIN RESOLVER" Then
                            nSin = nSin + 1
                            aColor(nDest - 1) = RGB(255, 199, 206)
                        Else
                            nRev = nRev + 1
                            aColor(nDest - 1) = RGB(255, 235, 156)
                        End If
                    End If

                    nDest  = nDest + 1
                    nDatos = nDatos + 1
                Loop
                nFila = nDatos - 1
            End If
        End If

        nFila = nFila + 1
    Wend

    ' Volcado en bloque: una sola escritura para toda la hoja
    If nDest > 1 Then
        ReDim Preserve aSalida(nDest - 2)
        oRes.getCellRangeByPosition(0, 1, 7, nDest - 1).setDataArray(aSalida)

        For k = 0 To nDest - 2
            If aColor(k) <> -1 And aColor(k) <> 0 Then
                oRes.getCellByPosition(7, k + 1).CellBackColor = aColor(k)
            End If
        Next k
    End If

    oProgreso.end()
    oDoc.unlockControllers()
    bBloqueado = False

    ' OptimalWidth solo en A:G. La columna H puede tener textos larguisimos
    ' y el ancho optimo se va de rango.
    For j = 0 To 6
        oRes.getColumns().getByIndex(j).OptimalWidth = True
    Next j
    oRes.getColumns().getByIndex(7).Width = 12000

    oDoc.getCurrentController().setActiveSheet(oRes)

    If oSheets.hasByName("worksheet") Then oSheets.removeByName("worksheet")
    If oSheets.hasByName("Worksheet") Then oSheets.removeByName("Worksheet")
    If oSheets.hasByName("WORKSHEET") Then oSheets.removeByName("WORKSHEET")

    If nDest > 1 Then
        Dim oRango As Object, oFrame As Object, oDisp As Object
        oRango = oRes.getCellRangeByPosition(0, 1, 6, nDest - 1)
        oDoc.getCurrentController().select(oRango)
        oFrame = oDoc.getCurrentController().getFrame()
        oDisp  = createUnoService("com.sun.star.frame.DispatchHelper")
        oDisp.executeDispatch(oFrame, ".uno:Copy", "", 0, Array())
    End If

    MsgBox "Proceso terminado." & Chr(10) & Chr(10) & _
           "Mesas procesadas:                  " & (nDest - 1) & Chr(10) & _
           "  . Sin observaciones:             " & nOK  & Chr(10) & _
           "  . Amarillas, revisar diferencia: " & nRev & Chr(10) & _
           "  . Rojas, sin resolver:           " & nSin & Chr(10) & Chr(10) & _
           "El rango A2:G ya esta en el portapapeles.", 0, "Resumen de Mesas"
    Exit Sub


ManejoError:
    On Error Resume Next
    If Not IsNull(oProgreso) Then oProgreso.end()
    If bBloqueado Then oDoc.unlockControllers()
    On Error Goto 0

    MsgBox "La macro se detuvo por un error." & Chr(10) & Chr(10) & _
           "Error " & Err & ": " & Error$ & Chr(10) & _
           "Linea de Basic: " & Erl & Chr(10) & Chr(10) & _
           "Fila del reporte: " & (nFila + 1) & Chr(10) & _
           "Ultima materia leida: " & sTitulo & Chr(10) & _
           "Mesas escritas hasta ahora: " & (nDest - 1) & Chr(10) & Chr(10) & _
           "Pasame esta pantalla y lo corrijo.", 16, "Error en ResumirMesasExamen"
End Sub


'======================================================================
' Helpers para la lectura en bloque del reporte
'======================================================================
Function TextoDe(vValor As Variant) As String
    If IsNull(vValor) Or IsEmpty(vValor) Then
        TextoDe = ""
    ElseIf VarType(vValor) = 8 Then
        TextoDe = Trim(vValor)
    ElseIf vValor = 0 Then
        ' getDataArray devuelve 0 en celdas vacias segun la version.
        ' Solo se usa para detectar, nunca para tomar valores, asi que
        ' tratarlo como vacio es lo correcto.
        TextoDe = ""
    Else
        TextoDe = Trim(CStr(vValor))
    End If
End Function


Function TextoFila(vFila As Variant, nCol1 As Integer, nCol2 As Integer) As String
    Dim j As Integer, s As String
    s = ""
    For j = nCol1 To nCol2
        If j <= UBound(vFila) Then s = s & " " & TextoDe(vFila(j))
    Next j
    TextoFila = Trim(s)
End Function


'══════════════════════════════════════════════════════════════════════════
' RESOLVER UNA MESA  →  Array(presidente, vocal1, vocal2, estado)
'
' Dos etapas:
'   1) Gana la fila con más puntaje (código + materia + tribunal).
'   2) Si esa fila NO comparte al menos nReq docentes con el reporte, se
'      descarta y se busca la fila que mejor coincide por TRIBUNAL.
'   3) Si tampoco, no se inventa nada: los roles quedan vacíos.
'══════════════════════════════════════════════════════════════════════════
Function ResolverMesa(sCod As String, sMat As String, aRepO(), aRepN(), aRepTok()) As Variant
    Dim nF As Long, nElegida As Long, nAlt As Long
    Dim dMejor As Double
    Dim aP() As Double
    Dim aSim() As Double
    Dim aC() As Integer
    Dim sCodN As String, sCodNum As String, sMatN As String
    Dim sPresRef As String, sNota As String
    Dim bAmbiguo As Boolean
    Dim vSalida As Variant
    Dim nReq As Integer, nRep As Integer
    Dim nMejorC As Integer
    Dim dMejorS As Double
    Dim i As Integer

    sCodN   = NormalizarTexto(sCod)
    sCodNum = SoloDigitos(sCod)
    sMatN   = NormalizarTexto(sMat)
    nRep    = UBound(aRepN) + 1

    ' Cuántos docentes tienen que coincidir para creerle a la fila
    nReq = 2
    If nRep < 2 Then nReq = nRep

    '--- Atajo -----------------------------------------------------------
    ' Caso normal: el código coincide exacto y el tribunal cierra.
    ' Se resuelve sin puntuar las ~225 filas de la BD. Esto es lo que hace
    ' que la macro termine en segundos en vez de minutos.
    If Len(sCodN) > 0 Then
        For nF = 0 To gN - 1
            If Len(gCod(nF)) > 0 Then
                If gCod(nF) = sCodN Then
                    dMejor = PuntajeFila(nF, sCodN, sCodNum, sMatN, aRepN, aRepTok)
                    If gCoinc >= nReq Then
                        ResolverMesa = AsignarRoles(aRepO, aRepN, nF)
                        Exit Function
                    End If
                End If
            End If
        Next nF
    End If

    '--- Camino largo: puntuar todas las filas ----------------------------
    ReDim aP(gN - 1)
    ReDim aC(gN - 1)
    ReDim aSim(gN - 1)

    dMejor   = -1
    nElegida = -1
    For nF = 0 To gN - 1
        aP(nF) = PuntajeFila(nF, sCodN, sCodNum, sMatN, aRepN, aRepTok)
        aC(nF) = gCoinc
        aSim(nF) = gSumSim
        If aP(nF) > dMejor Then
            dMejor   = aP(nF)
            nElegida = nF
        End If
    Next nF

    sNota = ""

    '--- Etapa 2: el tribunal manda ---------------------------------------
    ' Ojo: Basic no hace cortocircuito, así que no se puede evaluar
    ' aC(nElegida) en la misma condición que nElegida < 0.
    Dim bDescartar As Boolean
    bDescartar = True
    If nElegida >= 0 Then
        If dMejor >= PUNTAJE_MIN And aC(nElegida) >= nReq Then bDescartar = False
    End If

    If bDescartar Then
        nMejorC = 0
        dMejorS = 0
        nAlt    = -1
        For nF = 0 To gN - 1
            If aC(nF) > nMejorC Then
                nMejorC = aC(nF)
                dMejorS = aSim(nF)
                nAlt    = nF
            ElseIf aC(nF) = nMejorC And nMejorC > 0 Then
                If aSim(nF) > dMejorS Then
                    dMejorS = aSim(nF)
                    nAlt    = nF
                End If
            End If
        Next nF

        If nAlt >= 0 And nMejorC >= nReq Then
            If nAlt <> nElegida Then
                sNota = " | Fila ubicada por el tribunal: en la BD figura como [" & _
                        Trim(gCodO(nAlt) & " " & gMatO(nAlt)) & "]"
            End If
            nElegida = nAlt
        Else
            nElegida = -1
        End If
    End If

    '--- Sin resolver: NO se inventa ninguna asignación --------------------
    If nElegida < 0 Then
        Dim sLista As String
        sLista = ""
        For i = 0 To UBound(aRepO)
            If i > 0 Then sLista = sLista & ", "
            sLista = sLista & aRepO(i)
        Next i
        ResolverMesa = Array("", "", "", _
            "SIN RESOLVER: no se encontró en la BD una mesa de [" & Trim(sCod & " " & sMat) & _
            "] con este tribunal. Docentes del reporte: " & sLista)
        Exit Function
    End If

    '--- Empate con presidentes distintos ---------------------------------
    bAmbiguo = False
    sPresRef = gDocN(nElegida, 0)
    For nF = 0 To gN - 1
        If nF <> nElegida Then
            If aP(nF) >= aP(nElegida) - 0.01 And aC(nF) >= nReq Then
                If gDocN(nF, 0) <> sPresRef Then bAmbiguo = True
            End If
        End If
    Next nF

    vSalida = AsignarRoles(aRepO, aRepN, nElegida)

    If bAmbiguo Then
        sNota = sNota & " | Hay otra fila en la BD que encaja igual pero con otro presidente"
    End If

    If Len(sNota) > 0 Then
        If vSalida(3) = "OK" Then
            vSalida(3) = "REVISAR:" & sNota
        Else
            vSalida(3) = vSalida(3) & sNota
        End If
    End If

    ResolverMesa = vSalida
End Function


'══════════════════════════════════════════════════════════════════════════
' PUNTAJE de una fila de la BD frente a la mesa del reporte.
' Deja además en gCoinc la cantidad de docentes que coinciden y en
' gSumSim la suma de similitudes.
'══════════════════════════════════════════════════════════════════════════
Function PuntajeFila(nF As Long, sCodN As String, sCodNum As String, _
                     sMatN As String, aRepN(), aRepTok()) As Double
    Dim p As Double, d As Double, dMax As Double
    Dim i As Integer, j As Integer, k As Integer
    Dim vTok As Variant
    Dim bPosible As Boolean

    p       = 0
    gCoinc  = 0
    gSumSim = 0

    If Len(gCod(nF)) > 0 And Len(sCodN) > 0 Then
        If gCod(nF) = sCodN Then
            p = p + 100
        ElseIf Len(gCodNum(nF)) > 0 And gCodNum(nF) = sCodNum Then
            p = p + 70
        End If
    End If

    If Len(gMat(nF)) > 0 And Len(sMatN) > 0 Then
        If gMat(nF) = sMatN Then
            p = p + 55
        ElseIf Similitud(gMat(nF), sMatN) >= 0.8 Then
            p = p + 30
        End If
    End If

    For i = 0 To UBound(aRepN)
        vTok = aRepTok(i)
        dMax = 0
        For j = 0 To 2
            If Len(gDocN(nF, j)) > 0 Then
                bPosible = False
                If UBound(vTok) < 0 Then
                    bPosible = True
                Else
                    For k = 0 To UBound(vTok)
                        If InStr(gDocN(nF, j), vTok(k)) > 0 Then
                            bPosible = True
                            Exit For
                        End If
                    Next k
                End If
                If bPosible Then
                    d = Similitud(aRepN(i), gDocN(nF, j))
                    If d > dMax Then dMax = d
                End If
            End If
        Next j
        If dMax >= UMBRAL_DOC Then
            p       = p + 20 * dMax
            gCoinc  = gCoinc + 1
            gSumSim = gSumSim + dMax
        End If
    Next i

    PuntajeFila = p
End Function


'══════════════════════════════════════════════════════════════════════════
' ASIGNACIÓN GLOBAL DE ROLES
'══════════════════════════════════════════════════════════════════════════
Function AsignarRoles(aRepO(), aRepN(), nF As Long) As Variant
    Dim nRep As Integer
    Dim i As Integer, j As Integer
    Dim mS() As Double
    Dim aAsig(2) As Integer
    Dim aUsado() As Boolean
    Dim sOut(2) As String
    Dim sEstado As String
    Dim dMejor As Double
    Dim iM As Integer, jM As Integer
    Dim bColocado As Boolean

    nRep = UBound(aRepO) + 1
    ReDim mS(nRep - 1, 2)
    ReDim aUsado(nRep - 1)

    For i = 0 To nRep - 1
        For j = 0 To 2
            mS(i, j) = Similitud(aRepN(i), gDocN(nF, j))
        Next j
    Next i

    For j = 0 To 2
        aAsig(j) = -1
        sOut(j)  = ""
    Next j

    Do
        dMejor = UMBRAL_DOC
        iM = -1
        jM = -1
        For i = 0 To nRep - 1
            If Not aUsado(i) Then
                For j = 0 To 2
                    If aAsig(j) = -1 Then
                        If mS(i, j) > dMejor Then
                            dMejor = mS(i, j)
                            iM = i
                            jM = j
                        End If
                    End If
                Next j
            End If
        Next i
        If iM = -1 Then Exit Do
        aAsig(jM)  = iM
        aUsado(iM) = True
    Loop

    For j = 0 To 2
        If aAsig(j) >= 0 Then
            If USAR_NOMBRE_BD Then
                sOut(j) = gDocO(nF, j)
            Else
                sOut(j) = aRepO(aAsig(j))
            End If
        End If
    Next j

    sEstado = ""

    ' Docentes del reporte que no coinciden con nadie de la fila.
    ' Se ubican en un casillero libre solo porque la fila YA fue validada
    ' por el tribunal: son diferencias reales, no un relleno a ciegas.
    For i = 0 To nRep - 1
        If Not aUsado(i) Then
            bColocado = False
            For j = 0 To 2
                If aAsig(j) = -1 And Not bColocado Then
                    sOut(j)   = aRepO(i)
                    aAsig(j)  = -2
                    bColocado = True
                    If Len(gDocO(nF, j)) = 0 Then
                        sEstado = sEstado & "DE MÁS en el reporte: [" & aRepO(i) & _
                                  "] (en la BD ese rol está vacío). "
                    Else
                        sEstado = sEstado & "DISTINTO en " & NombreRol(j) & _
                                  ": reporte=[" & aRepO(i) & "] / BD=[" & gDocO(nF, j) & "]. "
                    End If
                End If
            Next j
            If Not bColocado Then
                sEstado = sEstado & "SOBRA en el reporte: [" & aRepO(i) & "]. "
            End If
        End If
    Next i

    For j = 0 To 2
        If Len(sOut(j)) = 0 And Len(gDocO(nF, j)) > 0 Then
            sEstado = sEstado & "FALTA " & NombreRol(j) & " (BD: [" & gDocO(nF, j) & "]). "
        End If
    Next j

    If Len(sEstado) = 0 Then
        sEstado = "OK"
    Else
        sEstado = "REVISAR: " & Trim(sEstado)
    End If

    AsignarRoles = Array(sOut(0), sOut(1), sOut(2), sEstado)
End Function


Function NombreRol(j As Integer) As String
    Select Case j
        Case 0    : NombreRol = "Presidente"
        Case 1    : NombreRol = "Vocal 1"
        Case Else : NombreRol = "Vocal 2"
    End Select
End Function


'══════════════════════════════════════════════════════════════════════════
' DIAGNÓSTICO
' Pegar la línea de la materia y la celda de docentes del reporte y
' muestra las 6 filas de la BD mejor puntuadas, con el desglose.
'══════════════════════════════════════════════════════════════════════════
Sub DiagnosticarMesa()
    Dim oBD As Object
    Dim sTitulo As String, sDocentes As String
    Dim sCod As String, sMat As String
    Dim sCodN As String, sCodNum As String, sMatN As String
    Dim aRepO As Variant, aRepN As Variant, aRepTok As Variant
    Dim aP() As Double
    Dim aC() As Integer
    Dim nF As Long, i As Integer, k As Integer
    Dim nTop As Long
    Dim dTop As Double
    Dim bUsada() As Boolean
    Dim sMsg As String

    sTitulo = InputBox("Pegá la línea de la materia del reporte." & Chr(10) & _
                       "Ej:  (16055) BIOLOGIA EVOLUTIVA", "Diagnóstico 1/2")
    If Len(Trim(sTitulo)) = 0 Then Exit Sub

    sDocentes = InputBox("Pegá la celda de Docentes del reporte." & Chr(10) & _
                         "Ej:  MARCINKEVICIUS MAURO SEBASTIAN, RIERA MARINA GRISELDA", "Diagnóstico 2/2")
    If Len(Trim(sDocentes)) = 0 Then Exit Sub

    oBD = AbrirBaseDatos(RUTA_BD)
    If IsNull(oBD) Then Exit Sub
    CargarBaseDatos(oBD)
    oBD.close(True)

    sCod    = ExtraerCodigoMateria(sTitulo)
    sMat    = ExtraerNombreMateria(sTitulo)
    sCodN   = NormalizarTexto(sCod)
    sCodNum = SoloDigitos(sCod)
    sMatN   = NormalizarTexto(sMat)

    aRepO   = SepararDocentes(sDocentes)
    aRepN   = NormalizarLista(aRepO)
    aRepTok = TokenizarLista(aRepN)

    ReDim aP(gN - 1)
    ReDim aC(gN - 1)
    ReDim bUsada(gN - 1)
    For nF = 0 To gN - 1
        aP(nF) = PuntajeFila(nF, sCodN, sCodNum, sMatN, aRepN, aRepTok)
        aC(nF) = gCoinc
    Next nF

    sMsg = "REPORTE" & Chr(10) & _
           "  código   : [" & sCod & "]  -> normalizado [" & sCodN & "]" & Chr(10) & _
           "  materia  : [" & sMat & "]  -> normalizado [" & sMatN & "]" & Chr(10) & _
           "  docentes :" & Chr(10)
    For i = 0 To UBound(aRepN)
        sMsg = sMsg & "     " & (i + 1) & ") [" & aRepN(i) & "]" & Chr(10)
    Next i
    sMsg = sMsg & Chr(10) & "FILAS DE LA BD MEJOR PUNTUADAS" & Chr(10) & _
           "(se necesitan 2 docentes coincidentes para aceptar la fila)" & Chr(10) & Chr(10)

    For k = 1 To 6
        dTop = -1
        nTop = -1
        For nF = 0 To gN - 1
            If Not bUsada(nF) And aP(nF) > dTop Then
                dTop = aP(nF)
                nTop = nF
            End If
        Next nF
        If nTop < 0 Then Exit For
        bUsada(nTop) = True
        sMsg = sMsg & k & ")  puntaje " & Format(dTop, "0.0") & _
               "   docentes que coinciden: " & aC(nTop) & Chr(10) & _
               "     BD: [" & gCodO(nTop) & "] " & gMatO(nTop) & Chr(10) & _
               "     P : " & gDocO(nTop, 0) & Chr(10) & _
               "     V1: " & gDocO(nTop, 1) & Chr(10) & _
               "     V2: " & gDocO(nTop, 2) & Chr(10) & Chr(10)
    Next k

    MsgBox sMsg, 0, "Diagnóstico de la mesa"
End Sub


'══════════════════════════════════════════════════════════════════════════
' SIMILITUD ENTRE DOS NOMBRES YA NORMALIZADOS
'══════════════════════════════════════════════════════════════════════════
Function Similitud(sA As String, sB As String) As Double
    Dim aA As Variant, aB As Variant
    Dim bUsado() As Boolean
    Dim i As Integer, j As Integer
    Dim nCom As Integer, nMin As Integer

    If Len(sA) = 0 Or Len(sB) = 0 Then
        Similitud = 0
        Exit Function
    End If
    If sA = sB Then
        Similitud = 1
        Exit Function
    End If

    aA = Split(sA, " ")
    aB = Split(sB, " ")
    ReDim bUsado(UBound(aB))
    nCom = 0

    For i = 0 To UBound(aA)
        If Len(aA(i)) > 1 Then
            For j = 0 To UBound(aB)
                If Not bUsado(j) Then
                    If aA(i) = aB(j) Then
                        bUsado(j) = True
                        nCom = nCom + 1
                        Exit For
                    End If
                End If
            Next j
        End If
    Next i

    nMin = UBound(aA) + 1
    If UBound(aB) + 1 < nMin Then nMin = UBound(aB) + 1
    If nMin < 1 Then nMin = 1

    If nCom < 2 Then
        Similitud = nCom / (nMin * 3)
    Else
        Similitud = nCom / nMin
    End If
End Function


'══════════════════════════════════════════════════════════════════════════
' NORMALIZACIÓN
'══════════════════════════════════════════════════════════════════════════
Function NormalizarTexto(sTexto As String) As String
    Dim s As String, r As String, c As String
    Dim i As Integer, p As Integer
    Dim sOrig As String, sDest As String

    sOrig = "ÁÀÄÂÃÉÈËÊÍÌÏÎÓÒÖÔÕÚÙÜÛÑÇáàäâãéèëêíìïîóòöôõúùüûñç"
    sDest = "AAAAAEEEEIIIIOOOOOUUUUNCAAAAAEEEEIIIIOOOOOUUUUNC"

    s = Trim(sTexto)
    r = ""
    For i = 1 To Len(s)
        c = Mid(s, i, 1)
        p = InStr(sOrig, c)
        If p > 0 Then c = Mid(sDest, p, 1)
        r = r & c
    Next i

    r = UCase(r)
    r = Replace(r, Chr(10), " ")
    r = Replace(r, Chr(13), " ")
    r = Replace(r, Chr(9),  " ")
    r = Replace(r, Chr(160)," ")
    r = Replace(r, ",",  " ")
    r = Replace(r, ".",  " ")
    r = Replace(r, ";",  " ")
    r = Replace(r, ":",  " ")
    r = Replace(r, "-",  " ")
    r = Replace(r, "_",  " ")
    r = Replace(r, "/",  " ")
    r = Replace(r, "(",  " ")
    r = Replace(r, ")",  " ")
    r = Replace(r, "'",  " ")
    r = Replace(r, """", " ")
    Do While InStr(r, "  ") > 0
        r = Replace(r, "  ", " ")
    Loop

    NormalizarTexto = Trim(r)
End Function


Function NormalizarLista(aOrig()) As Variant
    Dim aOut() As String
    Dim i As Integer
    If UBound(aOrig) < 0 Then
        NormalizarLista = Array()
        Exit Function
    End If
    ReDim aOut(UBound(aOrig))
    For i = 0 To UBound(aOrig)
        aOut(i) = AplicarEquivalencia(NormalizarTexto(aOrig(i)))
    Next i
    NormalizarLista = aOut
End Function


Function TokenizarLista(aNorm()) As Variant
    Dim aOut() As Variant
    Dim i As Integer
    If UBound(aNorm) < 0 Then
        TokenizarLista = Array()
        Exit Function
    End If
    ReDim aOut(UBound(aNorm))
    For i = 0 To UBound(aNorm)
        aOut(i) = TokensLargos(aNorm(i))
    Next i
    TokenizarLista = aOut
End Function


Function TokensLargos(sNorm As String) As Variant
    Dim aT As Variant
    Dim aOut() As String
    Dim i As Integer, n As Integer
    aT = Split(sNorm, " ")
    ReDim aOut(UBound(aT))
    n = 0
    For i = 0 To UBound(aT)
        If Len(aT(i)) >= 4 Then
            aOut(n) = aT(i)
            n = n + 1
        End If
    Next i
    If n = 0 Then
        TokensLargos = Array()
    Else
        ReDim Preserve aOut(n - 1)
        TokensLargos = aOut
    End If
End Function


Function SoloDigitos(sTexto As String) As String
    Dim i As Integer, c As String, r As String
    r = ""
    For i = 1 To Len(sTexto)
        c = Mid(sTexto, i, 1)
        If c >= "0" And c <= "9" Then r = r & c
    Next i
    SoloDigitos = r
End Function


Function AplicarEquivalencia(sNorm As String) As String
    Dim i As Long
    AplicarEquivalencia = sNorm
    For i = 0 To gEqN - 1
        If gEqDe(i) = sNorm Then
            AplicarEquivalencia = gEqA(i)
            Exit Function
        End If
    Next i
End Function


'══════════════════════════════════════════════════════════════════════════
' LECTURA DEL REPORTE
'══════════════════════════════════════════════════════════════════════════
Function SepararDocentes(sTexto As String) As Variant
    Dim aTmp As Variant
    Dim aOut() As String
    Dim i As Integer, n As Integer
    Dim s As String

    sTexto = Trim(sTexto)
    If Len(sTexto) = 0 Then
        SepararDocentes = Array()
        Exit Function
    End If

    aTmp = Split(sTexto, ",")
    ReDim aOut(UBound(aTmp))
    n = 0
    For i = 0 To UBound(aTmp)
        s = Trim(aTmp(i))
        Do While InStr(s, "  ") > 0
            s = Replace(s, "  ", " ")
        Loop
        If Len(s) > 1 Then
            aOut(n) = s
            n = n + 1
        End If
    Next i

    If n = 0 Then
        SepararDocentes = Array()
    Else
        ReDim Preserve aOut(n - 1)
        SepararDocentes = aOut
    End If
End Function


Function ExtraerCodigoMateria(sTexto As String) As String
    Dim n As Integer
    sTexto = Trim(sTexto)
    If Left(sTexto, 1) = "(" Then
        n = InStr(sTexto, ")")
        If n > 0 Then
            ExtraerCodigoMateria = Trim(Mid(sTexto, 2, n - 2))
        Else
            ExtraerCodigoMateria = Trim(Mid(sTexto, 2))
        End If
    Else
        ExtraerCodigoMateria = ""
    End If
End Function


Function ExtraerNombreMateria(sTexto As String) As String
    Dim n As Integer
    sTexto = Trim(sTexto)
    If Left(sTexto, 1) = "(" Then
        n = InStr(sTexto, ")")
        If n > 0 Then
            ExtraerNombreMateria = Trim(Mid(sTexto, n + 1))
            Exit Function
        End If
    End If
    ExtraerNombreMateria = sTexto
End Function


Function LeerFilaTexto(oSheet As Object, nFila As Long, nCol1 As Integer, nCol2 As Integer) As String
    Dim j As Integer, s As String
    s = ""
    For j = nCol1 To nCol2
        s = s & " " & Trim(oSheet.getCellByPosition(j, nFila).getString())
    Next j
    LeerFilaTexto = Trim(s)
End Function


Function UltimaFila(oSheet As Object) As Long
    Dim oCur As Object
    oCur = oSheet.createCursor()
    oCur.gotoEndOfUsedArea(False)
    UltimaFila = oCur.RangeAddress.EndRow
End Function


'══════════════════════════════════════════════════════════════════════════
' CARGA DE LA BASE DE DATOS
'══════════════════════════════════════════════════════════════════════════
Sub CargarBaseDatos(oBD As Object)
    Dim oS As Object, oD As Object
    Dim nUlt As Long, nFila As Long, n As Long
    Dim sCod As String, sMat As String
    Dim sP As String, sV1 As String, sV2 As String
    Dim sDrive As String, sRep As String, sCorr As String

    oS   = oBD.Sheets.getByIndex(0)
    nUlt = UltimaFila(oS)

    ReDim gCod(nUlt)
    ReDim gCodNum(nUlt)
    ReDim gMat(nUlt)
    ReDim gCodO(nUlt)
    ReDim gMatO(nUlt)
    ReDim gDocO(nUlt, 2)
    ReDim gDocN(nUlt, 2)

    n = 0
    For nFila = BD_FILA_1 To nUlt
        sCod = Trim(oS.getCellByPosition(BD_COL_COD,  nFila).getString())
        sMat = Trim(oS.getCellByPosition(BD_COL_MAT,  nFila).getString())
        sP   = Trim(oS.getCellByPosition(BD_COL_PRES, nFila).getString())
        sV1  = Trim(oS.getCellByPosition(BD_COL_VOC1, nFila).getString())
        sV2  = Trim(oS.getCellByPosition(BD_COL_VOC2, nFila).getString())

        If Len(sMat) > 0 Or Len(sP) > 0 Then
            gCodO(n)    = sCod
            gMatO(n)    = sMat
            gCod(n)     = NormalizarTexto(sCod)
            gCodNum(n)  = SoloDigitos(sCod)
            gMat(n)     = NormalizarTexto(sMat)
            gDocO(n, 0) = sP
            gDocO(n, 1) = sV1
            gDocO(n, 2) = sV2
            gDocN(n, 0) = NormalizarTexto(sP)
            gDocN(n, 1) = NormalizarTexto(sV1)
            gDocN(n, 2) = NormalizarTexto(sV2)
            n = n + 1
        End If
    Next nFila
    gN = n

    gEqN = 0
    ReDim gEqDe(1)
    ReDim gEqA(1)

    If oBD.Sheets.hasByName("DOCENTES") Then
        oD   = oBD.Sheets.getByName("DOCENTES")
        nUlt = UltimaFila(oD)
        ReDim gEqDe(nUlt * 2 + 2)
        ReDim gEqA(nUlt * 2 + 2)
        For nFila = 1 To nUlt
            sDrive = NormalizarTexto(oD.getCellByPosition(0, nFila).getString())
            sRep   = NormalizarTexto(oD.getCellByPosition(1, nFila).getString())
            sCorr  = NormalizarTexto(oD.getCellByPosition(2, nFila).getString())
            If Len(sDrive) > 0 Then
                If Len(sRep) > 0 And sRep <> sDrive Then
                    gEqDe(gEqN) = sRep
                    gEqA(gEqN)  = sDrive
                    gEqN = gEqN + 1
                End If
                If Len(sCorr) > 0 And sCorr <> sDrive Then
                    gEqDe(gEqN) = sCorr
                    gEqA(gEqN)  = sDrive
                    gEqN = gEqN + 1
                End If
            End If
        Next nFila
    End If
End Sub


'══════════════════════════════════════════════════════════════════════════
' APERTURA DEL ARCHIVO DE BASE DE DATOS
'══════════════════════════════════════════════════════════════════════════
Function AbrirBaseDatos(sRuta As String) As Object
    Dim oDocBD As Object, oFA As Object, oFP As Object
    Dim bExiste As Boolean
    Dim sSel As String

    oFA = CreateUnoService("com.sun.star.ucb.SimpleFileAccess")

    On Error Resume Next
    bExiste = oFA.exists(ConvertToURL(sRuta))
    On Error Goto 0

    If bExiste Then
        On Error Resume Next
        oDocBD = StarDesktop.loadComponentFromURL(ConvertToURL(sRuta), "_blank", 0, Array())
        On Error Goto 0
        If Not IsNull(oDocBD) Then
            AbrirBaseDatos = oDocBD
            Exit Function
        End If
    End If

    MsgBox "No se encontró la base de datos en:" & Chr(10) & sRuta & Chr(10) & Chr(10) & _
           "Seleccionala manualmente.", 48, "Archivo no encontrado"

    oFP = CreateUnoService("com.sun.star.ui.dialogs.FilePicker")
    oFP.appendFilter("Hojas de cálculo (*.ods;*.xlsx)", "*.ods;*.xlsx")
    oFP.appendFilter("Todos los archivos (*.*)", "*.*")
    oFP.setCurrentFilter("Hojas de cálculo (*.ods;*.xlsx)")

    On Error Resume Next
    oFP.setDisplayDirectory(ConvertToURL("/home/cristian/Documentos/"))
    On Error Goto 0

    If oFP.execute() = 1 Then
        sSel = oFP.getFiles()(0)
        On Error Resume Next
        oDocBD = StarDesktop.loadComponentFromURL(sSel, "_blank", 0, Array())
        On Error Goto 0
        If Not IsNull(oDocBD) Then
            AbrirBaseDatos = oDocBD
            Exit Function
        End If
    End If

    AbrirBaseDatos = Nothing
End Function
